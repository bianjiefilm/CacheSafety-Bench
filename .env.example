# OpenAI-compatible endpoint settings.
# Do not commit real API keys or customer data.
# Used by -provider openai and by -observe (gateway serve-mode observation).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# OPENAI_TIMEOUT_SECONDS=60

# Optional judge / embedding settings for advanced local experiments.
JUDGE_MODEL=
EMBEDDING_MODEL=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=
